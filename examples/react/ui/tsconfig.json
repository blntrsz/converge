{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext", "DOM"],
    "types": ["bun", "react"],
    "paths": {
      "@/*": ["./src/*"],
      "@converge/react-core": ["../core/src/index.ts"],
      "@converge/react-core/*": ["../core/src/*"]
    }
